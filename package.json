{
  "name": "fits-backend",
  "version": "1.0.0",
  "description": "本地 FITS 主图像卡片解析与物理像素缩放后端（API + CLI）",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/parser.test.js dist/test/store.test.js",
    "start": "npm run build && node dist/src/server.js",
    "cli": "npm run build && node dist/src/cli.js",
    "demo": "npm run build && node dist/scripts/demo.js"
  },
  "devDependencies": {
    "@types/node": "*",
    "typescript": "5.9"
  }
}
